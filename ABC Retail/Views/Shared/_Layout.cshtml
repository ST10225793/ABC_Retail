<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ABC Retail</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
            :root {
                --hk-pink-bg: #ffe4e1;
                --hk-card-bg: #fff0f5;
                --hk-accent-pink: #ffb6c1;
                --hk-dark-pink: #ff69b4;
                --hk-deep-rose: #db7093;
                --hk-text: #4a2e35;
            }

            body {
                background-color: var(--hk-pink-bg);
                color: var(--hk-text);
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .navbar-custom {
                background-color: #ffffff;
                border-bottom: 4px solid var(--hk-accent-pink);
                box-shadow: 0 4px 10px rgba(255, 182, 193, 0.4);
            }

            .navbar-brand {
                color: var(--hk-dark-pink) !important;
                font-weight: 700;
                font-size: 1.5rem;
            }

            .nav-link {
                color: var(--hk-text) !important;
                font-weight: 600;
                margin: 0 5px;
                border-radius: 15px;
                padding: 8px 16px !important;
                transition: all 0.3s ease;
            }

            .nav-link:hover {
                background-color: var(--hk-card-bg);
                color: var(--hk-dark-pink) !important;
            }

            .hk-card {
                background-color: #ffffff;
                border: 2px solid var(--hk-accent-pink);
                border-radius: 20px;
                box-shadow: 0 6px 12px rgba(255, 182, 193, 0.3);
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }

            .hk-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 18px rgba(255, 105, 180, 0.3);
            }

            .hk-btn {
                background-color: var(--hk-dark-pink);
                color: #ffffff;
                border: none;
                border-radius: 20px;
                padding: 10px 24px;
                font-weight: 600;
                box-shadow: 0 4px 8px rgba(255, 105, 180, 0.4);
                transition: all 0.3s ease;
            }

            .hk-btn:hover {
                background-color: var(--hk-deep-rose);
                color: #ffffff;
            }

            footer {
                background-color: #ffffff;
                border-top: 2px solid var(--hk-accent-pink);
                color: var(--hk-text);
                padding: 15px 0;
                margin-top: 40px;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light navbar-custom">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-ribbon me-2"></i>ABC Retail
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-auto justify-content-end">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house me-1"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Profiles" asp-action="Index"><i class="fa-solid fa-users me-1"></i> Profiles & Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Media" asp-action="Index"><i class="fa-solid fa-image me-1"></i> Blob Media</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Orders" asp-action="Index"><i class="fa-solid fa-list-check me-1"></i> Queue Orders</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Logs" asp-action="Index"><i class="fa-solid fa-file-lines me-1"></i> File Logs</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="text-center">
        <div class="container">
            <small>&copy; 2026 - ABC Retail - Azure Storage Portal <i class="fa-solid fa-heart text-danger ms-1"></i></small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>