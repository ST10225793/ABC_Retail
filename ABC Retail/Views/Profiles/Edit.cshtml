@model ABC_Retail.Models.CustomerProfile

@{
    ViewData["Title"] = "Edit Customer Profile";
}

<div class="container py-3">
    <div class="text-center mb-4">
        <h2 class="fw-bold" style="color: var(--hk-dark-pink);">
            <i class="fa-solid fa-user-pen me-2"></i>Edit Customer Profile
        </h2>
        <p class="text-muted">Update contact and address details stored in Azure Table Storage[cite: 1].</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card hk-card p-4">
                <form asp-action="Edit" method="post">
                    <!-- Hidden Azure ITableEntity Keys -->
                    <input type="hidden" asp-for="PartitionKey" />
                    <input type="hidden" asp-for="RowKey" />
                    <input type="hidden" asp-for="ETag" />
                    <input type="hidden" asp-for="Timestamp" />

                    <div class="mb-2">
                        <label asp-for="FirstName" class="form-label small fw-bold"></label>
                        <input asp-for="FirstName" class="form-control rounded-3" required />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="LastName" class="form-label small fw-bold"></label>
                        <input asp-for="LastName" class="form-control rounded-3" required />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Email" class="form-label small fw-bold"></label>
                        <input asp-for="Email" type="email" class="form-control rounded-3" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="PhoneNumber" class="form-label small fw-bold"></label>
                        <input asp-for="PhoneNumber" class="form-control rounded-3" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label small fw-bold"></label>
                        <input asp-for="Address" class="form-control rounded-3" required />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between gap-2 mt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill w-50">
                            <i class="fa-solid fa-arrow-left me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn hk-btn w-50">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Update Profile
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>