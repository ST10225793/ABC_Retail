@model ABC_Retail.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex flex-column align-items-center justify-content-center min-vh-75 py-4">

    <div class="text-center mb-5 max-w-750">
        <h1 class="display-4 fw-bold" style="color: var(--hk-dark-pink);">
            <i class="fa-solid fa-sparkles me-2"></i>ABC Retail Management Hub
        </h1>
        <p class="lead" style="color: var(--hk-text);">
            Welcome to your central store workspace. Easily view shoppers, update product listings, track order dispatching, and audit system activity from one place.
        </p>
    </div>

    <!-- Centered 4-Card Layout with Live Metrics -->
    <div class="row g-4 justify-content-center w-100 max-w-1000 mb-5">

        <!-- Customer Profiles -->
        <div class="col-sm-6 col-lg-3">
            <div class="card hk-card h-100 p-3 text-center">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-end mb-1">
                            <span class="badge bg-primary rounded-pill fs-6">@Model.TotalCustomers Saved</span>
                        </div>
                        <i class="fa-solid fa-address-card fa-3x mb-3" style="color: var(--hk-dark-pink);"></i>
                        <h5 class="card-title fw-bold">Customer Profiles</h5>
                        <p class="card-text text-muted small">
                            View registered customer accounts and update contact details stored in Azure Tables.
                        </p>
                    </div>
                    <a asp-controller="Profiles" asp-action="Index" class="btn hk-btn mt-3">View Profiles</a>
                </div>
            </div>
        </div>

        <!-- Product Catalog -->
        <div class="col-sm-6 col-lg-3">
            <div class="card hk-card h-100 p-3 text-center">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-end mb-1">
                            <span class="badge bg-success rounded-pill fs-6">@Model.TotalProducts Listed</span>
                        </div>
                        <i class="fa-solid fa-boxes-packing fa-3x mb-3" style="color: var(--hk-dark-pink);"></i>
                        <h5 class="card-title fw-bold">Product Catalog</h5>
                        <p class="card-text text-muted small">
                            Browse store items, update pricing, and upload images to Azure Blob Storage.
                        </p>
                    </div>
                    <a asp-controller="Products" asp-action="Index" class="btn hk-btn mt-3">View Products</a>
                </div>
            </div>
        </div>

        <!-- Inventory Manager -->
        <div class="col-sm-6 col-lg-3">
            <div class="card hk-card h-100 p-3 text-center">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-end mb-1">
                            <span class="badge bg-warning text-dark rounded-pill fs-6">@Model.TotalQueueMessages Active</span>
                        </div>
                        <i class="fa-solid fa-truck-fast fa-3x mb-3" style="color: var(--hk-dark-pink);"></i>
                        <h5 class="card-title fw-bold">Inventory Manager</h5>
                        <p class="card-text text-muted small">
                            Monitor incoming orders and track processing events in Azure Queue Storage.
                        </p>
                    </div>
                    <a asp-controller="Orders" asp-action="Index" class="btn hk-btn mt-3">View Inventory</a>
                </div>
            </div>
        </div>

        <!-- System Logs -->
        <div class="col-sm-6 col-lg-3">
            <div class="card hk-card h-100 p-3 text-center">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-end mb-1">
                            <span class="badge bg-info text-dark rounded-pill fs-6">@Model.TotalLogFiles Files</span>
                        </div>
                        <i class="fa-solid fa-clipboard-check fa-3x mb-3" style="color: var(--hk-dark-pink);"></i>
                        <h5 class="card-title fw-bold">System Logs</h5>
                        <p class="card-text text-muted small">
                            Access operational log files and contracts saved to Azure Files Share.
                        </p>
                    </div>
                    <a asp-controller="Logs" asp-action="Index" class="btn hk-btn mt-3">View Logs</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Live Azure Queue Activity Table -->
    <div class="w-100 max-w-1000">
        <div class="card hk-card p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0" style="color: var(--hk-dark-pink);">
                    <i class="fa-solid fa-list-check me-2"></i>Live Queue Activity (Azure Queue Storage)
                </h5>
                <a asp-controller="Orders" asp-action="Index" class="btn btn-sm hk-btn">Full Queue Manager</a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: var(--hk-card-bg); color: var(--hk-text);">
                        <tr>
                            <th>Queue Message Event</th>
                            <th>Timestamp</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentQueueEvents.Any())
                        {
                            <tr>
                                <td colspan="2" class="text-center text-muted py-3">
                                    No active messages in the Azure Queue. Send test messages from the Inventory Manager.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var eventItem in Model.RecentQueueEvents)
                            {
                                <tr>
                                    <td>
                                        <i class="fa-solid fa-envelope-open me-2 text-primary"></i>
                                        <strong>@eventItem.MessageText</strong>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @(eventItem.InsertedOn.HasValue ? eventItem.InsertedOn.Value.ToString("yyyy-MM-dd HH:mm:ss") : "N/A")
                                        </small>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>