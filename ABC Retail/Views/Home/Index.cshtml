@{
    ViewData["Title"] = "Dashboard";
}

<div class="text-center my-4">
    <h1 class="display-4 fw-bold" style="color: var(--hk-dark-pink);">
        <i class="fa-solid fa-ribbon me-2"></i>ABC Retail Storage Dashboard
    </h1>
    <p class="lead" style="color: var(--hk-text);">
        Management hub for Azure Storage Services[cite: 1]. Select a service below to process and view data records[cite: 1].
    </p>
</div>

<div class="row g-4 mt-2">
    <!-- Table Storage Card -->
    <div class="col-md-6 col-lg-3">
        <div class="card hk-card h-100 p-3 text-center">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <i class="fa-solid fa-table-cells fa-3x mb-3" style="color: var(--hk-dark-pink);"></i>
                    <h5 class="card-title fw-bold">Azure Tables</h5>
                    <p class="card-text text-muted small">Store customer profiles and product details[cite: 1].</p>
                </div>
                <a asp-controller="Profiles" asp-action="Index" class="btn hk-btn mt-3">Manage Tables</a>
            </div>
        </div>
    </div>

    <!-- Blob Storage Card -->
    <div class="col-md-6 col-lg-3">
        <div class="card hk-card h-100 p-3 text-center">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <i class="fa-solid fa-photo-film fa-3x mb-3" style="color: var(--hk-dark-pink);"></i>
                    <h5 class="card-title fw-bold">Azure Blobs</h5>
                    <p class="card-text text-muted small">Upload and display product images and multimedia[cite: 1].</p>
                </div>
                <a asp-controller="Media" asp-action="Index" class="btn hk-btn mt-3">Manage Media</a>
            </div>
        </div>
    </div>

    <!-- Queue Storage Card -->
    <div class="col-md-6 col-lg-3">
        <div class="card hk-card h-100 p-3 text-center">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <i class="fa-solid fa-truck-ramp-box fa-3x mb-3" style="color: var(--hk-dark-pink);"></i>
                    <h5 class="card-title fw-bold">Azure Queues</h5>
                    <p class="card-text text-muted small">Queue order transactions and processing updates[cite: 1].</p>
                </div>
                <a asp-controller="Orders" asp-action="Index" class="btn hk-btn mt-3">Manage Queues</a>
            </div>
        </div>
    </div>

    <!-- File Storage Card -->
    <div class="col-md-6 col-lg-3">
        <div class="card hk-card h-100 p-3 text-center">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <i class="fa-solid fa-folder-open fa-3x mb-3" style="color: var(--hk-dark-pink);"></i>
                    <h5 class="card-title fw-bold">Azure Files</h5>
                    <p class="card-text text-muted small">Upload and access system log files by filename[cite: 1].</p>
                </div>
                <a asp-controller="Logs" asp-action="Index" class="btn hk-btn mt-3">Manage Logs</a>
            </div>
        </div>
    </div>
</div>