@model ABC_Retail.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container py-3">
    <div class="text-center mb-4">
        <h2 class="fw-bold" style="color: var(--hk-dark-pink);">
            <i class="fa-solid fa-pen-to-square me-2"></i>Edit Product
        </h2>
        <p class="text-muted">Update product information and optional photo stored in Azure Storage[cite: 1].</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card hk-card p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="PartitionKey" />
                    <input type="hidden" asp-for="RowKey" />
                    <input type="hidden" asp-for="ETag" />
                    <input type="hidden" asp-for="Timestamp" />
                    <input type="hidden" asp-for="ImageUrl" />

                    <div class="mb-3 text-center">
                        <label class="form-label small fw-bold d-block">Current Image</label>
                        <img src="@Model.ImageUrl" alt="@Model.Name" class="rounded-3 border shadow-sm mb-2" style="max-height: 150px; object-fit: cover;" />
                    </div>

                    <div class="mb-2">
                        <label asp-for="Name" class="form-label small fw-bold"></label>
                        <input asp-for="Name" class="form-control rounded-3" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Price" class="form-label small fw-bold"></label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control rounded-3" required />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Description" class="form-label small fw-bold"></label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="3" required></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Replace Image (Optional)</label>
                        <input type="file" name="imageFile" class="form-control rounded-3" accept="image/*" />
                        <small class="text-muted">Leave empty to keep the existing image.</small>
                    </div>

                    <div class="d-flex justify-content-between gap-2 mt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill w-50">
                            <i class="fa-solid fa-arrow-left me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn hk-btn w-50">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>