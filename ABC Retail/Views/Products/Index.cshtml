@model IEnumerable<ABC_Retail.Models.Product>

@{
    ViewData["Title"] = "Product Catalog";
}

<div class="container py-3">
    <div class="text-center mb-4">
        <h2 class="fw-bold" style="color: var(--hk-dark-pink);">
            <i class="fa-solid fa-boxes-packing me-2"></i>Product Catalog
        </h2>
        <p class="text-muted">Manage product listings, pricing, and multimedia images stored in Azure Blob Storage.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Add Product Form -->
        <div class="col-lg-4">
            <div class="card hk-card p-4">
                <h5 class="fw-bold mb-3" style="color: var(--hk-dark-pink);">
                    <i class="fa-solid fa-plus-circle me-2"></i>Add New Product
                </h5>
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Product Name</label>
                        <input name="Name" class="form-control rounded-3" placeholder="e.g. Hello Kitty Mug" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Price (R)</label>
                        <input name="Price" type="number" step="0.01" class="form-control rounded-3" placeholder="149.99" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Description</label>
                        <textarea name="Description" class="form-control rounded-3" rows="2" placeholder="Product details..." required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Product Image</label>
                        <input type="file" name="imageFile" class="form-control rounded-3" accept="image/*" required />
                    </div>
                    <button type="submit" class="btn hk-btn w-100 mt-2">
                        <i class="fa-solid fa-cloud-arrow-up me-2"></i>Upload Product
                    </button>
                </form>
            </div>
        </div>

        <!-- Product Gallery Grid -->
        <div class="col-lg-8">
            <div class="card hk-card p-3">
                <h5 class="fw-bold mb-3" style="color: var(--hk-dark-pink);">
                    <i class="fa-solid fa-store me-2"></i>Uploaded Products (5+ Records)
                </h5>
                <div class="row g-3">
                    @if (!Model.Any())
                    {
                        <p class="text-center text-muted py-4">No products uploaded yet. Use the form to add at least 5 items.</p>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <div class="col-sm-6 col-md-4">
                                <div class="card h-100 border rounded-4 overflow-hidden shadow-sm">
                                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 160px; object-fit: cover;" />
                                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                                        <div>
                                            <h6 class="fw-bold mb-1">@item.Name</h6>
                                            <p class="text-muted small mb-2 text-truncate">@item.Description</p>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-bold fs-6" style="color: var(--hk-dark-pink);">R @item.Price.ToString("F2")</span>
                                            <a href="@item.ImageUrl" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill">
                                                <i class="fa-solid fa-up-right-from-square"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>